{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DAA Workspace",
  "version": "0.1.0",
  "identifier": "com.fad.dsa-project",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DAA Workspace",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 600,
        "backgroundColor": "#21070f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
